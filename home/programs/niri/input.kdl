input {
    keyboard {
        // Parameters go to libxkbcommon (see xkeyboard-config(7)); "/-" keeps niri on
        // the systemd-localed keymap.
        /- xkb {
            layout "us"
            options "caps:escape_shifted_capslock"
            // variant ""                   // default: unset
            // model ""                     // default: unset
            // rules ""                     // default: unset
            // file "~/.config/keymap.xkb"  // default: unset; overrides all of the above
        }
        // Omitting this disables numlock.
        numlock
    }

    // Commented-out settings below are examples, not defaults.
    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // Uncomment to warp the mouse to newly focused windows.
    // warp-mouse-to-focus

    // Focus on hover; "0%" limits it to fully visible windows.
    // focus-follows-mouse max-scroll-amount="0%"
}
