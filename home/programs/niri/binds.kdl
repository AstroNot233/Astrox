binds {
    // Hotkeys
    Mod+Return repeat=false { spawn "ghostty"; }

    // Focus: WASD shape on Colemak's h n e i o home row, u=up, n=left, e=down, i=right.
    Mod+N { focus-column-left-or-last;   }
    Mod+I { focus-column-right-or-first; }
    Mod+U { focus-window-up-or-bottom;   }
    Mod+E { focus-window-down-or-top;    }
    // Workspaces on L=up, Y=down, flanking the navigation up key.
    Mod+L { focus-workspace-up;   }
    Mod+Y { focus-workspace-down; }

    // Move
    Mod+Ctrl+N { move-column-left;  }
    Mod+Ctrl+I { move-column-right; }
    Mod+Ctrl+U { move-window-up;    }
    Mod+Ctrl+E { move-window-down;  }
    Mod+Ctrl+L { move-workspace-up;   }
    Mod+Ctrl+Y { move-workspace-down; }

    // Resize
    Mod+Shift+N { set-window-width "-10%";  }
    Mod+Shift+I { set-window-width "+10%";  }
    Mod+Shift+U { set-window-height "-10%"; }
    Mod+Shift+E { set-window-height "+10%"; }
    Mod+backslash    repeat=false { expand-column-to-available-width; }
    Mod+BracketLeft  repeat=false { set-window-width "50%";  }
    Mod+BracketRight repeat=false { set-window-width "100%"; }
    Mod+Semicolon    repeat=false { maximize-window-to-edges; }
    Mod+Apostrophe   repeat=false { fullscreen-window;        }

    // Window Management
    Mod+Tab    repeat=false { toggle-overview; }
    Mod+Escape repeat=false { close-window; }
    Mod+Comma  repeat=false { toggle-window-floating; }
    Mod+Period repeat=false { switch-focus-between-floating-and-tiling; }
    Mod+C      repeat=false { center-visible-columns; }
    Mod+T      repeat=false { toggle-column-tabbed-display; }

    // Noctalia
    Mod+X repeat=false { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+V repeat=false { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Ctrl+Alt+Delete repeat=false { spawn-sh "noctalia msg panel-toggle session"; }

    // Screenshots
         Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
     Alt+Print { screenshot-window; }
}
